# Configuração usada pelos scripts db:backup / db:restore (src/cli.ts).
# Copie para .env. O .env está no .gitignore — nunca versione senhas.
PG_CONTAINER=band-tools-postgres
PG_USER=band_tools
PG_DATABASE=band_tools_db
# PG_PASSWORD=
ALLOWED_DIRS=/mnt/c/backups/postgres

# Só se o Node rodar no Windows e o Docker no WSL:
# DOCKER_COMMAND=wsl.exe
# DOCKER_COMMAND_ARGS=-d Ubuntu -- docker
# ALLOWED_DIRS=C:\backups\postgres
